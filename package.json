{
  "name": "berrygood-dashboard",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "vite build",
    "lint": "node scripts/lint.cjs",
    "test:unit": "find tests/unit -name '*.test.js' -print0 | xargs -0 -r node --test",
    "qa": "bash scripts/qa.sh",
    "code-index": "node scripts/generate-code-index.js",
    "typecheck": "tsc -p jsconfig.json",
    "coverage": "c8 --reporter=text --reporter=html npm run test:unit",
    "test": "node tests/test-workflows.js",
    "smoke": "BASE_URL=https://berrygood-farms-dashboard.web.app node tests/smoke-test.js",
    "smoke:sprint-1": "node tests/smoke-sprint-1.js",
    "deploy:functions": "bash scripts/deploy.sh functions",
    "deploy:hosting": "bash scripts/deploy.sh hosting",
    "test:finance": "find functions/lib/finance/__tests__ -name '*.test.js' -print0 | xargs -0 -r node --test",
    "test:all": "find tests/unit functions/lib/finance/__tests__ -name '*.test.js' -print0 | xargs -0 -r node --test",
    "build:vercel": "npm run build && node scripts/migrate/assemble-vercel.cjs",
    "vercel:config": "node scripts/migrate/gen-vercel-config.cjs",
    "build:vercel:demo": "DEMO_NO_AUTH=1 npm run build:vercel",
    "migrate:verify": "node scripts/migrate/verify-references.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.3.1",
    "playwright": "^1.58.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5"
  },
  "directories": {
    "test": "tests"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-react": "^7.28.5",
    "@vitejs/plugin-react": "^4.7.0",
    "c8": "^11.0.0",
    "pg": "^8.23.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  },
  "type": "commonjs"
}
