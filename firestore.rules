rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Authenticated users can read their own profile
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Admin-only via Cloud Functions
    }

    // SQL mirror collections — read-only for authenticated users
    match /sql_mirror_pointage/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Sync service only (admin SDK)
    }

    match /sql_mirror_consommation/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /sql_mirror_cueillette/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /sql_mirror_pointage_meta/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /sql_mirror_pointage_workers/{docId} {
      // Étape 4 sécu paie : lecture CF-only (admin SDK), 0 lecture client-direct confirmée
      allow read: if false;
      allow write: if false;
    }

    // Référentiel parcelle→ferme (docs/spec-referentiel-parcelle-ferme.md).
    // Alimente le cloisonnement ferme (fail-closed). CF-only : construit par le
    // job de synchro (admin SDK), 0 lecture client-direct (cohérent Étape 4).
    match /parcelle_ferme_referentiel/{docId} {
      allow read: if false;
      allow write: if false;
    }
    match /parcelle_ferme_referentiel_meta/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Production harvest scans (Tracabilite_recolte) — synced every 15 min from prod SQL.
    // Read-only for authenticated users (used by the Récolte tab live listener).
    match /prod_tracabilite_recolte/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // sync service only (admin SDK)
    }

    // Quinzaine archive — persisted summaries for older quinzaines
    match /quinzaine_archive/{docId} {
      // Étape 4 sécu paie : lecture CF-only (admin SDK), 0 lecture client-direct confirmée
      allow read: if false;
      allow write: if false;
    }

    // CPC snapshots — persisted summaries for CPC dashboard
    match /cpc_snapshots/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // API cache — read-only for authenticated users
    match /api_cache/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Cloud Functions only
    }

    // Validations — authenticated users can read, write via Cloud Functions
    match /validations/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Validation Pointage du jour PAR ÉQUIPE / PAR FERME — lecture par utilisateurs
    // authentifiés, écriture via Cloud Function exports.pointageValidation uniquement.
    match /pointage_validations_equipe/{date} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Stock requests
    match /stock_requests/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Budgets
    match /budgets/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Connection logs — no client access
    match /connection_logs/{docId} {
      allow read, write: if false;
    }

    // Sync status — read-only
    match /sql_sync_status/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Quality data (expeditions, liquidations)
    match /expeditions/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /liquidations/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Driscoll's weekly forecast prices (Grower return prices) imported from slides
    match /liquidation_forecasts/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // written only via Cloud Function (admin SDK)
    }

    // Driscoll's Grower productivity reports — weekly ranking F1 (172) / F5 (195)
    // Read filtering is enforced UI-side via NAV items (chef_f1/chef_f5/finance/dg only)
    match /productivity_reports/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // written only via Cloud Function (admin SDK)
    }

    // Notifications
    match /notifications/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Evolution requests — authenticated users can read and write
    match /evolution_requests/{docId} {
      allow read, write: if request.auth != null;
    }

    // Tasks — authenticated users can read and write
    match /tasks/{docId} {
      allow read, write: if request.auth != null;
    }

    // App settings — authenticated users can read and write
    match /app_settings/{docId} {
      allow read, write: if request.auth != null;
    }

    // Bons d'apport saisie — authenticated users can read and write
    match /bons_apport_saisie/{docId} {
      allow read, write: if request.auth != null;
    }

    // PFQ interne (bons de production) — authenticated users can read and write
    match /pfq_interne/{docId} {
      allow read, write: if request.auth != null;
    }
    match /scan_corrections/{docId} {
      allow read, write: if request.auth != null;
    }
    match /clients_marche_local/{docId} {
      allow read, write: if request.auth != null;
    }

    // Irrigation readings — authenticated users can read and write
    match /irrigation_readings/{docId} {
      allow read, write: if request.auth != null;
    }

    // Netafim — registre des parcelles BAHIA découvert dynamiquement par le cron.
    // Lecture par utilisateurs authentifiés ; écriture réservée au cron (admin SDK).
    match /netafim_parcelles_bahia/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Security — mouvements entrées/sorties et photos tunnels
    match /security_mouvements/{docId} {
      allow read, write: if request.auth != null;
    }
    match /security_scan_registre/{docId} {
      allow read, write: if request.auth != null;
    }
    match /security_tunnel_photos/{docId} {
      allow read, write: if request.auth != null;
    }
    // WhatsApp bot — registres envoyés par les agents sécurité
    match /security_envois_registre/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // écrit uniquement par le webhook (Cloud Function)
    }
    // WhatsApp bot — incidents signalés par les agents sécurité
    match /security_incidents/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // écrit uniquement par le webhook (Cloud Function)
    }
    // WhatsApp bot — état conversationnel par numéro (privé, server-only)
    match /whatsapp_sessions/{phone} {
      allow read, write: if false;
    }

    // Stock movements — read-only for authenticated users, write via Cloud Functions
    match /stock_movements/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Bug reports — signalements in-app. Lecture par utilisateurs authentifiés
    // (la vue admin filtrée arrive en Phase B). Écriture via Cloud Function
    // exports.bugReports uniquement (admin SDK).
    match /bug_reports/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Stock balances — read-only for authenticated users, write via Cloud Functions
    match /stock_balances/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Consumption costs by variety — read-only, populated by import script
    match /consumption_costs_by_variety/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Caisse definitions — read for authenticated, write via Cloud Functions
    match /caisse_definitions/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Caisse transactions — read for authenticated, write via Cloud Functions
    match /caisse_transactions/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // WhatsApp logs — read-only for authenticated, write via Cloud Functions
    match /whatsapp_logs/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // WhatsApp incoming messages — read-only for authenticated, write via webhook
    match /whatsapp_messages/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Config — admin-only via Cloud Functions
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // RH config (transport_primes, etc.) — read for all auth, write for auth
    // (le profil RH est filtré côté UI ; les autres profils n'ont pas l'onglet)
    match /rh_config/{docId} {
      allow read, write: if request.auth != null;
    }

    // Ouvriers registry — registre des ouvriers (déclaré/non déclaré, baseline
    // ancienneté, prime de fonction). ÉCRITURE DE PAIE : write exclusivement via
    // la Cloud Function gated primesManagement (/api/primes, rôle RH/DG vérifié
    // serveur). Lecture autorisée pour tout user authentifié (calcul paie front).
    match /ouvriers_registry/{matricule} {
      // Étape 1 sécu paie : lecture CF-only (admin SDK) via /api/registry ; 0 lecture client-direct (grep confirmé). Write déjà CF-only.
      allow read: if false;
      allow write: if false;
    }

    // Référentiel des fonctions (libellé + ordre d'affichage + prime de
    // référence). Lecture seule pour tout user authentifié (groupement UI de
    // l'onglet Primes Fixes). Écriture via Cloud Function uniquement (plus tard).
    match /fonctions/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Trésorerie — échéances, loyers, paie, engagements (Finance & DG via UI)
    match /tresorerie_items/{docId} {
      allow read, write: if request.auth != null;
    }

    // Suivi Croissance Framboise — lecture toute auth, écriture via Cloud Function (rôle agronomie)
    match /growth_measurements/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /growth_plot_config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Mapping parcelles de consommation — lecture toute auth, écriture via Cloud Function (mappingConsoManagement)
    match /parcelles_consommation/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /mapping_campagne/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /parcelles_culturales_charge/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Groupes de parcelles (raccourci de saisie du Bon de Consommation) —
    // lecture toute auth (le magasinier doit voir les groupes dans le popup BC),
    // écriture via Cloud Function uniquement (pointageRH ?action=sb-groupe-save,
    // gate DG/RH/admin).
    match /sb_parcelle_groupes/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Budget JH/Ha par parcelle × famille d'opération (campagne dans la clé).
    // CF-only DANS LES DEUX SENS — même convention que sb_parcelle_referentiel
    // (non déclaré ici → deny par défaut) : le client lit via
    // pointageRH ?action=campagne-budget-list, qui applique le cloisonnement
    // ferme d'un chef. Une lecture client directe court-circuiterait ce filtre.
    // Écriture : pointageRH ?action=campagne-budget-save (gate DG/RH/admin).
    match /sb_campagne_budget_jh/{docId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
