{
  "compilerOptions": {
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "commonjs",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@features/*": [
        "src/features/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ],
      "@app/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "public/lib/**/*.js",
    "functions/lib/**/*.js",
    "tests/unit/**/*.js",
    "src/**/*.js",
    "src/**/*.jsx"
  ],
  "exclude": [
    "**/node_modules",
    "public/app.js",
    "public/app.jsx",
    "functions/index.js"
  ]
}