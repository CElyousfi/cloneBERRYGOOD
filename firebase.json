{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "target": "photos",
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/bdp-introspect", "function": { "functionId": "bdpIntrospect", "region": "europe-west1" } },
      { "source": "/api/sync-pointage-bdp-test", "function": { "functionId": "syncPointageBdpTrigger", "region": "europe-west1" } },
      { "source": "/api/validate-pointage-bdp-test", "function": { "functionId": "validatePointageBdpTrigger", "region": "europe-west1" } },
      { "source": "/api/backfill-pointage-bdp-live", "function": { "functionId": "backfillPointageBdpLiveTrigger", "region": "europe-west1" } },
      { "source": "/api/fertigation", "function": { "functionId": "fertigation", "region": "europe-west1" } },
      { "source": "/api/phytosanitaire", "function": { "functionId": "phytosanitaire", "region": "europe-west1" } },
      { "source": "/api/produits", "function": { "functionId": "produits", "region": "europe-west1" } },
      { "source": "/api/parcelles", "function": { "functionId": "parcelles", "region": "europe-west1" } },
      { "source": "/api/dashboard", "function": { "functionId": "dashboard", "region": "europe-west1" } },
      { "source": "/api/agro-summary", "function": { "functionId": "agroSummary", "region": "europe-west1" } },
      { "source": "/api/health", "function": { "functionId": "health", "region": "europe-west1" } },
      { "source": "/api/avancement", "function": { "functionId": "avancementCulture", "region": "europe-west1" } },
      { "source": "/api/growth", "function": { "functionId": "growthTracking", "region": "europe-west1" } },
      { "source": "/api/mapping-conso", "function": { "functionId": "mappingConsoManagement", "region": "europe-west1" } },
      { "source": "/api/upload-photo", "function": { "functionId": "uploadPhoto", "region": "europe-west1" } },
      { "source": "/api/recommandation", "function": { "functionId": "recommandation", "region": "europe-west1" } },
      { "source": "/api/backfill-presence", "function": { "functionId": "backfillPresence", "region": "europe-west1" } },
      { "source": "/api/farmroad", "function": { "functionId": "farmroad", "region": "europe-west1" } },
      { "source": "/api/ecarts", "function": { "functionId": "ecarts", "region": "europe-west1" } },
      { "source": "/api/email-analysis", "function": { "functionId": "emailAnalysis", "region": "europe-west1" } },
      { "source": "/api/pointage-rh", "function": { "functionId": "pointageV3", "region": "europe-west1" } },
      { "source": "/api/harvest-weather", "function": { "functionId": "harvestWeather", "region": "europe-west1" } },
      { "source": "/api/harvest-prediction", "function": { "functionId": "harvestPrediction", "region": "europe-west1" } },
      { "source": "/api/upload-ecarts", "function": { "functionId": "uploadEcarts", "region": "europe-west1" } },
      { "source": "/api/validation", "function": { "functionId": "validation", "region": "europe-west1" } },
      { "source": "/api/pointage-validation", "function": { "functionId": "pointageValidation", "region": "europe-west1" } },
      { "source": "/api/stock", "function": { "functionId": "stockManagement", "region": "europe-west1" } },
      { "source": "/api/auth", "function": { "functionId": "authApi", "region": "europe-west1" } },
      { "source": "/api/hors-recolte-suivi", "function": { "functionId": "horsRecolteService", "region": "europe-west1" } },
      { "source": "/api/budget", "function": { "functionId": "budgetService", "region": "europe-west1" } },
      { "source": "/api/meeting-cr", "function": { "functionId": "meetingCR", "region": "europe-west1" } },
      { "source": "/api/fuel", "function": { "functionId": "fuel", "region": "europe-west1" } },
      { "source": "/api/telecom", "function": { "functionId": "telecom", "region": "europe-west1" } },
      { "source": "/api/ojra", "function": { "functionId": "ojra", "region": "europe-west1" } },
      { "source": "/api/notifications", "function": { "functionId": "notifications", "region": "europe-west1" } },
      { "source": "/api/tasks", "function": { "functionId": "tasks", "region": "europe-west1" } },
      { "source": "/api/alerts", "function": { "functionId": "alerts", "region": "europe-west1" } },
      { "source": "/api/gdd-tracking", "function": { "functionId": "gddTracking", "region": "europe-west1" } },
      { "source": "/api/climat-production", "function": { "functionId": "climatProduction", "region": "europe-west1" } },
      { "source": "/api/backup", "function": { "functionId": "backupApi", "region": "europe-west1" } },
      { "source": "/api/indoor-forecast", "function": { "functionId": "indoorForecast", "region": "europe-west1" } },
      { "source": "/api/caisse", "function": { "functionId": "caisseManagement", "region": "europe-west1" } },
      { "source": "/api/primes", "function": { "functionId": "primesManagement", "region": "europe-west1" } },
      { "source": "/api/fonctions", "function": { "functionId": "fonctionsManagement", "region": "europe-west1" } },
      { "source": "/api/registry", "function": { "functionId": "registryService", "region": "europe-west1" } },
      { "source": "/api/whatsapp-admin", "function": { "functionId": "whatsappAdmin", "region": "europe-west1" } },
      { "source": "/api/whatsapp-webhook", "function": { "functionId": "whatsappWebhook", "region": "europe-west1" } },
      { "source": "/api/run-daily-phenology-job-now", "function": { "functionId": "runDailyPhenologyJobNow", "region": "europe-west1" } },
      { "source": "/api/run-sync-jours-feries-now", "function": { "functionId": "runSyncJoursFeriesNow", "region": "europe-west1" } },
      { "source": "/api/bug-reports", "function": { "functionId": "bugReports", "region": "europe-west1" } },
      { "source": "/api/sentinel-recipients", "function": { "functionId": "sentinelRecipients", "region": "europe-west1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "predeploy": ["npm run build:frontend"],
    "headers": [
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
      { "source": "**/*.json", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
      { "source": "/api/**", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store" }] }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20"
    }
  ],
  "emulators": {
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 8088 },
    "ui": { "enabled": true, "port": 4000 }
  }
}
