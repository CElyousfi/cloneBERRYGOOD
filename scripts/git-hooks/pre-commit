#!/usr/bin/env bash
# Pre-commit Smart Berry — gate rapide (tests seulement, pas de build).
#
# Activation (config locale, non versionnée — à refaire après un clone) :
#   git config core.hooksPath scripts/git-hooks
# Échappatoire ponctuelle : git commit --no-verify
#
# La racine est résolue via git (compatible worktrees multiples) et les tests
# sont lancés en forme portable find|xargs (fonctionne Node 20 et 24 — le glob
# quoté de npm run test:unit exige Node >= 21).
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
LOG="$(mktemp)"
trap 'rm -f "$LOG"' EXIT

run_quiet() {
  # Silencieux en succès, affiche le rapport de test complet en échec.
  if ! "$@" > "$LOG" 2>&1; then
    cat "$LOG"
    return 1
  fi
}

# DIL fingerprint check — régénère le graphe si les sources ont changé
DIL_GRAPH="$ROOT/docs/ai/module-graph.json"
if [ -f "$DIL_GRAPH" ]; then
  CURRENT_FP=$(node "$ROOT/scripts/generate-module-graph.js" --fingerprint-only 2>/dev/null || echo "")
  STORED_FP=$(node -e "try{const g=require('$DIL_GRAPH');console.log(g._meta&&g._meta.sourceFingerprint||'')}catch(e){console.log('')}" 2>/dev/null || echo "")
  if [ -n "$CURRENT_FP" ] && [ "$CURRENT_FP" != "$STORED_FP" ]; then
    echo "[pre-commit] DIL: sources modifiées, régénération de module-graph.json..."
    node "$ROOT/scripts/generate-module-graph.js"
    echo ""
    echo "[pre-commit] DIL: diff du graphe régénéré :"
    git -C "$ROOT" diff docs/ai/module-graph.json | head -50
    echo ""
    echo "[pre-commit] Commit bloqué : module-graph.json a été régénéré."
    echo "   Vérifiez le diff ci-dessus, puis :"
    echo "   git add docs/ai/module-graph.json"
    echo "   git commit"
    exit 1
  fi
fi

echo "[pre-commit] Tests unitaires frontend…"
(cd "$ROOT" && run_quiet bash -c "find tests/unit -name '*.test.js' -print0 | xargs -0 node --test")

echo "[pre-commit] Tests backend…"
(cd "$ROOT/functions" && run_quiet bash -c "find lib -path '*/__tests__/*.test.js' -print0 | xargs -0 node --test")

echo "[pre-commit] OK ✅ (gate complète avec build : npm run qa)"
