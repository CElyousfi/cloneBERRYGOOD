rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Backups d'imports (Excel + JSON parsé) — RH/Achats uniquement via app authentifiée
    match /data/{file=**} {
      allow read, write: if request.auth != null;
    }
    // Scans WhatsApp / bons d'apport + pièces jointes factures/BL/BDC.
    // Upload CLIENT-DIRECT (le fichier ne transite plus par la Cloud Function,
    // ce qui contourne la limite de payload 10 MB des functions 1ère gen).
    // Lecture authentifiée ; les métadonnées (scan_path, signed URL) sont
    // ensuite enregistrées sur le doc cible via l'action upload-attachment.
    // Écriture durcie : create-only (path unique horodaté) ; pas d'overwrite/
    // delete côté client. Taille + MIME ne sont PLUS vérifiés ici car en upload
    // resumable (mobile), request.resource.size / contentType sont peu fiables
    // au moment de la rule → faux refus storage/unauthorized. L'enforcement
    // taille (<25 MB) et MIME (PDF/image) est fait côté Cloud Function
    // (action upload-attachment) où les métadonnées de l'objet sont fiables ;
    // un objet refusé y est supprimé avant tout enregistrement de lien.
    match /scans/{path=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    // Fichiers stock quotidiens (magasinier) — dépôt CLIENT-DIRECT, même
    // modèle que scans/** ci-dessus (create-only, taille/MIME enforcés côté
    // Cloud Function stock-file-submit, pas fiable au niveau des rules en
    // upload resumable). Inclut stock_files/_pending/** : chemin temporaire
    // utilisé par le bot WhatsApp (magasinierBot.js) le temps de la
    // confirmation de ferme par boutons interactifs, avant déplacement vers
    // le chemin final stock_files/{date}/**.
    match /stock_files/{path=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    // États d'émargement des heures supplémentaires SIGNÉS par les chefs de
    // ferme, déposés par la RH — une pièce par ferme et par quinzaine. Dépôt
    // CLIENT-DIRECT create-only (chemin unique horodaté), pas d'overwrite ni de
    // delete côté client. Taille (<25 Mo) et MIME (PDF/image) NE SONT PAS
    // vérifiés ici — peu fiables en upload resumable mobile — mais côté Cloud
    // Function (action hs-emargement-submit), qui supprime l'objet refusé avant
    // tout enregistrement de lien.
    //
    // LECTURE INTERDITE — et surtout PAS `if request.auth != null` comme
    // scans/** ci-dessus. Ce namespace n'est JAMAIS lu par le SDK côté client :
    // le front passe exclusivement par l'action hs-emargement-url, qui renvoie
    // une URL signée V4 générée avec les credentials admin, APRÈS le gate de
    // rôle rh/dg/admin de primesManagement. Ouvrir la lecture à tout compte
    // authentifié annulerait silencieusement ce gate : un magasinier, un
    // caporal ou un chef de ferme pourrait lister puis télécharger les états
    // signés — noms d'ouvriers, heures accordées, signatures. Ne PAS re-copier
    // le bloc scans/** ici.
    match /rh_emargements/{path=**} {
      allow read: if false;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    // PDF des bons de commande (générés à la soumission, joints à la notif
    // WhatsApp de validation). Lecture+écriture authentifiée.
    match /bdc_pdfs/{path=**} {
      allow read, write: if request.auth != null;
    }
    // PDF des avis de virement BDC (uploadés par Finance).
    match /bdc_avis_virement/{path=**} {
      allow read, write: if request.auth != null;
    }
    // Captures jointes aux signalements de bug in-app. Écriture via Cloud
    // Function (admin SDK) ; lecture authentifiée.
    match /bug_reports/{path=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
