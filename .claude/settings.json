{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Task",
      "TodoWrite",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(scripts/deploy.sh:*)",
      "Bash(npm run deploy:*)",
      "Bash(gh workflow run:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git clean -xfd:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ..:*)",
      "Bash(rm -rf .:*)",
      "Bash(sudo:*)",
      "Bash(firebase deploy:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "additionalDirectories": [
      "/tmp",
      "/Users/omarmaaouni/Desktop/DESKTOP (OLD)",
      "/Users/omarmaaouni/worktrees"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{
          "type": "command",
          "command": "node",
          "args": ["${CLAUDE_PROJECT_DIR}/scripts/bash-discipline-gate.js"]
        }]
      }
    ]
  }
}
