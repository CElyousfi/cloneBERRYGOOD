{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(pwd)",
      "Bash(ls:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch)",
      "Bash(git fetch BERRYGOOD:*)",
      "Bash(git fetch --prune BERRYGOOD:*)",
      "Bash(git remote -v)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(git branch --contains:*)",
      "Bash(git branch --merged:*)",
      "Bash(git branch -vv)",
      "Bash(git stash list:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git commit --amend:*)",
      "Bash(git commit --fixup:*)",
      "Bash(git commit --squash:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git config:*)",
      "Bash(git rebase:*)",
      "Bash(git stash push:*)",
      "Bash(git stash pop:*)",
      "Bash(git stash apply:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git stash branch:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -f:*)",
      "Bash(git branch --delete:*)",
      "Bash(git push:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(sed -i:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(firebase hosting:channel:*)",
      "Bash(gcloud:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(firebase projects:list:*)",
      "Bash(npm run qa:*)",
      "Bash(npm run test:unit:*)",
      "Bash(npm run build:frontend:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm ls:*)",
      "Bash(node --version)",
      "Bash(node --check:*)",
      "Bash(node --test:*)",
      "Bash(node tests/smoke-test.js:*)",
      "Bash(node tests/smoke-sprint-1.js:*)",
      "Bash(node tests/test-workflows.js:*)",
      "Bash(node tests/test-chef-bdc-bot.js:*)",
      "Bash(node scripts/build-frontend.js:*)",
      "Bash(node scripts/permission-audit.js)",
      "Bash(node scripts/diag-readonly.js:*)",
      "Bash(python3 -m json.tool:*)",
      "Bash(firebase functions:log:*)",
      "WebSearch",
      "WebFetch(domain:developer.farmroad.io)",
      "WebFetch(domain:www.farmroad.io)",
      "WebFetch(domain:knowledge.farmroad.io)",
      "WebFetch(domain:www.waybeyond.io)",
      "WebFetch(domain:api.farmroad.io)"
    ],
    "ask": [
      "Bash(git push BERRYGOOD main:*)",
      "Bash(git push origin main:*)",
      "Bash(git merge:*)",
      "Bash(gh pr merge:*)",
      "Bash(npm run deploy:*)",
      "Bash(scripts/deploy.sh:*)",
      "Bash(./scripts/deploy.sh:*)",
      "Bash(bash scripts/deploy.sh:*)",
      "Bash(sh scripts/deploy.sh:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git clean -xfd:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ..:*)",
      "Bash(rm -rf .:*)",
      "Bash(sudo:*)",
      "Bash(firebase deploy:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{
          "type": "command",
          "command": "node",
          "args": ["${CLAUDE_PROJECT_DIR}/scripts/bash-discipline-gate.js"]
        }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -q 'firebase deploy'; then cd \"$CLAUDE_PROJECT_DIR\" && BASE_URL=https://berrygood-farms-dashboard.web.app node tests/smoke-test.js; fi"
          }
        ]
      }
    ]
  }
}
