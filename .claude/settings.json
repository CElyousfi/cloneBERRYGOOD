{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(pwd)",
      "Bash(ls:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(npm run qa:*)",
      "Bash(npm run test:unit:*)",
      "Bash(npm run build:frontend:*)",
      "Bash(npm run typecheck:*)",
      "Bash(python3 -m json.tool:*)",
      "Bash(firebase functions:log:*)",
      "WebSearch",
      "WebFetch(domain:developer.farmroad.io)",
      "WebFetch(domain:www.farmroad.io)",
      "WebFetch(domain:knowledge.farmroad.io)",
      "WebFetch(domain:www.waybeyond.io)",
      "WebFetch(domain:api.farmroad.io)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git config:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(sed -i:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(firebase deploy:*)",
      "Bash(firebase hosting:channel:*)",
      "Bash(gcloud:*)",
      "Bash(scripts/deploy.sh:*)",
      "Bash(./scripts/deploy.sh:*)",
      "Bash(bash scripts/deploy.sh:*)",
      "Bash(sh scripts/deploy.sh:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git clean -xfd:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ..:*)",
      "Bash(rm -rf .:*)",
      "Bash(sudo:*)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -q 'firebase deploy'; then cd \"$CLAUDE_PROJECT_DIR\" && BASE_URL=https://berrygood-farms-dashboard.web.app node tests/smoke-test.js; fi"
          }
        ]
      }
    ]
  }
}
