# Smart BERRY — variables d'environnement (modèle)
# Copier en .env.local pour le dev ; définir les mêmes clés dans Vercel.
# NE JAMAIS committer .env.local (ignoré par .gitignore).

# OpenWeather — météo temps réel (fermes Souss / Loukkos)
VITE_OPENWEATHER_API_KEY=

# Supabase — client navigateur (anon key : publique, protégée par RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — usage serveur/scripts UNIQUEMENT. Ne jamais préfixer VITE_ :
# tout ce qui commence par VITE_ est injecté dans le bundle navigateur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
